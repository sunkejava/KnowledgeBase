# KnowledgeBase 容器部署示例配置
# 生产环境必须修改 JWT_KEY 和 MEILISEARCH_API_KEY，禁止直接使用示例值。

JWT_KEY=Change-This-To-A-Long-Random-Production-Key
VITE_API_BASE_URL=http://localhost:5000/api

# 文件存储。当前实现 local，后续可增加 minio / s3 / oss / cos。
STORAGE_PROVIDER=local

# 默认使用 SQLite 内置搜索，无需启动 Meilisearch。
SEARCH_PROVIDER=sqlite

# 使用 Meilisearch 时设置 SEARCH_PROVIDER=meilisearch，
# 并通过 docker compose --profile search up -d 启动搜索服务。
MEILISEARCH_ENDPOINT=http://meilisearch:7700
MEILISEARCH_API_KEY=Change-This-To-A-Strong-Meilisearch-Master-Key
MEILISEARCH_INDEX_NAME=knowledge_documents
